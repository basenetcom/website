---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Carousel from './Carousel.astro';
import TrainingCard from './TrainingCard.astro';
import { getTrainingPrograms, displayTitle } from '../lib/training';
import { withBase } from '../nav';

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  action?: { label: string; href: string };
}

const {
  eyebrow = 'Corporate Training',
  title = 'Professional IT & Safety Training',
  description = 'Upskill your team with practical training programs designed for business productivity, data analysis and operational safety.',
  action = { label: 'More Info', href: withBase('/training') },
} = Astro.props;

const programs = await getTrainingPrograms();
const courses = programs.map((p) => ({
  image: p.icon,
  title: displayTitle(p),
  description: p.data.summary,
  focus: p.data.focus,
}));
---

{
  courses.length > 0 && (
    <section aria-labelledby="training-title" class="bg-brand-100">
      <div class="mx-auto max-w-6xl px-8 py-section">
        <header class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-12">
          <div class="font-semibold text-brand-900 lg:max-w-xl">
            <p class="text-2xl uppercase">{eyebrow}</p>
            <h2 id="training-title" class="mt-3.5 text-4xl/tight sm:text-display">{title}</h2>
          </div>
          <p class="max-w-prose text-body/[1.65] font-semibold text-copy lg:max-w-95">{description}</p>
        </header>

        <Carousel label="Training courses" itemsName="courses" class="mt-9">
          {courses.map((course) => <TrainingCard {...course} />)}
        </Carousel>

        <a
          href={action.href}
          class="mt-9 inline-flex items-center gap-1.5 rounded-sm bg-brand-900 px-3.5 py-3 text-small/[1.2] font-semibold text-white transition-colors hover:bg-brand-700 focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-brand-900 motion-reduce:transition-none"
        >
          {action.label}
          <ArrowUpRight size={14} aria-hidden="true" />
        </a>
      </div>
    </section>
  )
}
