---
import { Image } from 'astro:assets';
import panduit from '../assets/brands/panduit.png';
import fluke from '../assets/brands/fluke.png';
import cisco from '../assets/brands/cisco.png';
import dell from '../assets/brands/dell.png';
import microsoft from '../assets/brands/microsoft.png';
import apple from '../assets/brands/apple.svg';
import hp from '../assets/brands/hp.png';
import lenovo from '../assets/brands/lenovo.png';
import acer from '../assets/brands/acer.png';
import asus from '../assets/brands/asus.png';
import huawei from '../assets/brands/huawei.png';
import h3c from '../assets/brands/h3c.png';
import ruijie from '../assets/brands/ruijie.png';
import aruba from '../assets/brands/aruba.png';
import commscope from '../assets/brands/commscope.png';
import axis from '../assets/brands/axis.svg';
import apc from '../assets/brands/apc.png';
import vertiv from '../assets/brands/vertiv.png';
import epson from '../assets/brands/epson.png';
import canon from '../assets/brands/canon.png';
import hikvision from '../assets/brands/hikvision.png';
import dahua from '../assets/brands/dahua.png';
import fingertec from '../assets/brands/fingertec.png';
import ibm from '../assets/brands/ibm.png';
import tplink from '../assets/brands/tplink.png';
import omada from '../assets/brands/omada.png';
import rightpower from '../assets/brands/rightpower.png';
import sangfor from '../assets/brands/sangfor.png';
import acronis from '../assets/brands/acronis.svg';

interface Props {
  eyebrow?: string;
  title?: string;
}

const { eyebrow = 'Technology Ecosystem', title = 'Brands That Have Chosen Us' } = Astro.props;

const brands = [
  { name: 'Panduit', logo: panduit },
  { name: 'Fluke', logo: fluke },
  { name: 'Cisco', logo: cisco },
  { name: 'Dell', logo: dell },
  { name: 'Microsoft', logo: microsoft },
  { name: 'Apple', logo: apple },
  { name: 'HP', logo: hp },
  { name: 'Lenovo', logo: lenovo },
  { name: 'Acer', logo: acer },
  { name: 'ASUS', logo: asus },
  { name: 'Huawei', logo: huawei },
  { name: 'H3C', logo: h3c },
  { name: 'Ruijie', logo: ruijie },
  { name: 'Aruba', logo: aruba },
  { name: 'CommScope', logo: commscope },
  { name: 'Axis Communications', logo: axis },
  { name: 'APC', logo: apc },
  { name: 'Vertiv', logo: vertiv },
  { name: 'Epson', logo: epson },
  { name: 'Canon', logo: canon },
  { name: 'Hikvision', logo: hikvision },
  { name: 'Dahua', logo: dahua },
  { name: 'FingerTec', logo: fingertec },
];

const moreBrands = [
  { name: 'IBM', logo: ibm },
  { name: 'TP-Link', logo: tplink },
  { name: 'TP-Link Omada', logo: omada },
  { name: 'Right Power', logo: rightpower },
  { name: 'Sangfor', logo: sangfor },
  { name: 'Acronis', logo: acronis },
];

// Row 1 scrolls right-to-left, row 2 left-to-right.
// ~10s per logo keeps the scroll speed the same in both rows however many partners are listed.
const rows = [
  { label: 'Our technology partners', brands, reverse: false },
  { label: 'More technology partners', brands: moreBrands, reverse: true },
].map((row) => ({ ...row, duration: `${row.brands.length * 10}s` }));

// One set is the real list; the second is a decorative copy that makes the loop seamless.
const groups = [{ hidden: false }, { hidden: true }];
---

<section aria-labelledby="brands-title" class="bg-white">
  <div class="mx-auto max-w-6xl px-8 py-section">
    <header class="text-center text-brand-900">
      <p class="text-xl font-semibold uppercase">{eyebrow}</p>
      <h2 id="brands-title" class="mt-3.5 text-4xl/tight font-extrabold sm:text-display">{title}</h2>
    </header>

    <!-- Both rows pause together (hover / tap on the wrapper). -->
    <div class="marquees mt-10 flex flex-col gap-5" data-marquee>
      {
        rows.map((row) => (
          <div class="marquee" data-direction={row.reverse ? 'reverse' : undefined} style={`--duration: ${row.duration}`}>
            <div class="marquee-viewport">
              {groups.map(({ hidden }) => (
                <ul
                  class="marquee-group"
                  aria-label={hidden ? undefined : row.label}
                  aria-hidden={hidden ? 'true' : undefined}
                  inert={hidden}
                >
                  {row.brands.map(({ name, logo }) => (
                    <li class="flex h-26 w-72 max-w-full shrink-0 items-center justify-center rounded-sm border border-brand-100 bg-white p-4">
                      <Image src={logo} alt={hidden ? '' : name} height={64} loading="eager" fetchpriority="low" decoding="async" class="max-h-16 w-auto max-w-48 object-contain" />
                    </li>
                  ))}
                </ul>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Default (and prefers-reduced-motion: reduce): a static, wrapping grid. */
  .marquee-viewport {
    display: block;
  }
  .marquee-group {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
  }
  .marquee-group[aria-hidden='true'] {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .marquees {
      --gap: 1.25rem;
    }
    .marquee-viewport {
      display: flex;
      gap: var(--gap);
      overflow: hidden;
      -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
      mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    }
    .marquee-group,
    .marquee-group[aria-hidden='true'] {
      display: flex;
      flex-wrap: nowrap;
      flex-shrink: 0;
      min-width: 100%;
      justify-content: space-around;
      gap: var(--gap);
      animation: marquee-scroll var(--duration, 40s) linear infinite;
    }

    /* Pause on hover (pointer devices only, so touch has no sticky hover) or on tap (see script) — WCAG 2.2.2. */
    @media (hover: hover) {
      .marquees:hover .marquee-group {
        animation-play-state: paused;
      }
    }
    .marquees[data-paused='true'] .marquee-group {
      animation-play-state: paused;
    }
    /* Second row runs the other way (left to right). */
    .marquee[data-direction='reverse'] .marquee-group {
      animation-direction: reverse;
    }
  }

  @keyframes marquee-scroll {
    to {
      transform: translateX(calc(-100% - var(--gap)));
    }
  }
</style>

<script>
  // Touch devices have no hover: tapping the strip toggles pause/resume.
  const touchOnly = matchMedia('(hover: none)');
  document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((root) => {
    root.addEventListener('click', () => {
      if (!touchOnly.matches) return;
      root.dataset.paused = String(root.dataset.paused !== 'true');
    });
  });
</script>
