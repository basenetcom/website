---
import Phone from '@lucide/astro/icons/phone';
import Mail from '@lucide/astro/icons/mail';
import Clock from '@lucide/astro/icons/clock';
import { COMPANY } from '../site.config';

const linkClass =
  'rounded-sm hover:underline focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-brand-900';

const details = [
  { icon: Phone, label: 'Call us', value: COMPANY.phone.display, href: COMPANY.phone.href },
  { icon: Mail, label: 'Email us', value: COMPANY.email, href: `mailto:${COMPANY.email}` },
  { icon: Clock, label: 'Business hours', value: COMPANY.operatingHours },
];
---

<aside aria-label="Company information" class="flex flex-col gap-6">
  <section class="flex flex-col gap-4 rounded-lg bg-brand-75 p-7">
    <p class="text-caption font-semibold uppercase text-brand-900">A little about us</p>
    <h2 class="text-2xl/[1.3] font-semibold text-brand-900">{COMPANY.legalName}</h2>
    <p class="text-body/[1.7] text-copy">
      {COMPANY.tagline} Get to know our IT infrastructure solutions and services, or talk to us about your business needs.
    </p>
  </section>

  <section aria-labelledby="get-in-touch" class="flex flex-col gap-6.5 rounded-lg border border-brand-100 p-7">
    <div class="flex flex-col gap-2.5">
      <h2 id="get-in-touch" class="text-2xl font-semibold text-brand-900">Get in touch</h2>
      <p class="text-small/[1.6] text-copy">Prefer to contact us directly? Here’s how to reach BaseNET.</p>
    </div>

    <dl class="flex flex-col gap-6.5">
      {
        details.map(({ icon: Icon, label, value, href }) => (
          <div class="flex gap-3.5">
            <Icon size={20} aria-hidden="true" class="mt-0.5 shrink-0 text-brand-900" />
            <div class="flex min-w-0 flex-col gap-2">
              <dt class="text-caption text-muted">{label}</dt>
              <dd class="text-body font-medium break-words text-brand-900">
                {href ? <a href={href} class={linkClass}>{value}</a> : value}
              </dd>
            </div>
          </div>
        ))
      }
    </dl>

    {
      COMPANY.address && (
        <div class="flex flex-col gap-2 border-t border-brand-100 pt-5">
          <p class="text-caption text-muted">Office address</p>
          <address class="text-small text-muted not-italic">{COMPANY.address}</address>
        </div>
      )
    }
  </section>
</aside>
