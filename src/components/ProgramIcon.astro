---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import GraduationCap from '@lucide/astro/icons/graduation-cap';

interface Props {
  /** Null shows a generic icon, so a missing upload never leaves a hole in the layout. */
  image: ImageMetadata | null;
}

const { image } = Astro.props;
---

<div class="flex size-12 items-center justify-center overflow-hidden rounded-sm bg-brand-75">
  {
    image ? (
      <Image src={image} alt="" width={84} height={84} class="size-10 object-contain" />
    ) : (
      <GraduationCap size={26} aria-hidden="true" class="text-brand-900" />
    )
  }
</div>
