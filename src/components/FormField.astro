---
interface Props {
  id: string;
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel';
  autocomplete?: string;
  placeholder?: string;
  required?: boolean;
  /** Shown after the label instead of the required asterisk, e.g. "(optional)". */
  hint?: string;
  /** Render a <textarea> instead of an <input>. */
  multiline?: boolean;
  pattern?: string;
  /** Message used when `pattern` / `type` validation fails. */
  invalidMessage?: string;
  requiredMessage?: string;
}

const {
  id,
  name,
  label,
  type = 'text',
  autocomplete,
  placeholder,
  required = false,
  hint,
  multiline = false,
  pattern,
  invalidMessage,
  requiredMessage,
} = Astro.props;

const control =
  'w-full rounded-sm border border-muted bg-white p-3.5 text-small/[1.4] text-brand-900 placeholder:text-muted focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-brand-900 aria-invalid:border-red-700 aria-invalid:outline-red-700';
---

<div class="flex min-w-0 flex-col gap-2.5">
  <label for={id} class="text-small font-semibold text-brand-900">
    {label}
    {required && <span aria-hidden="true" class="font-normal"> *</span>}
    {hint && <span class="font-normal text-muted"> {hint}</span>}
  </label>

  {
    multiline ? (
      <textarea
        id={id}
        name={name}
        rows="4"
        required={required}
        placeholder={placeholder}
        aria-describedby={`${id}-error`}
        data-required-message={requiredMessage}
        class:list={[control, 'min-h-28 resize-y']}
      />
    ) : (
      <input
        id={id}
        name={name}
        type={type}
        autocomplete={autocomplete}
        required={required}
        placeholder={placeholder}
        pattern={pattern}
        aria-describedby={`${id}-error`}
        data-required-message={requiredMessage}
        data-invalid-message={invalidMessage}
        class:list={[control, 'h-12']}
      />
    )
  }
  <p id={`${id}-error`} data-error class="text-caption/[1.4] text-red-700" hidden></p>
</div>
