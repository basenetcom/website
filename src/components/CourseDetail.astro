---
import { render } from 'astro:content';
import ProgramIcon from './ProgramIcon.astro';
import { displayTitle, type TrainingProgram } from '../lib/training';

interface Props {
  program: TrainingProgram;
}

const { program } = Astro.props;
const { data, id } = program;
const { Content } = await render(program);
const hasBody = Boolean(program.body?.trim());
---

<article aria-labelledby={`course-${id}`} class="flex flex-col gap-8 border-t border-brand-100 py-10 lg:flex-row lg:gap-10">
  <div class="flex flex-col gap-4.5 lg:w-80 lg:shrink-0">
    <ProgramIcon image={program.icon} />
    {data.category && <p class="text-caption font-semibold uppercase tracking-[0.1em] text-muted">{data.category}</p>}
    <h3 id={`course-${id}`} class="text-3xl font-semibold tracking-tight text-brand-900 sm:text-heading">
      {displayTitle(program)}
    </h3>
    {data.tagline && <p class="text-lg/[1.65] text-copy">{data.tagline}</p>}
  </div>

  {
    data.topics.length > 0 && (
      <div class="flex min-w-0 flex-1 flex-col gap-5.5">
        <h4 class="text-lg font-semibold text-brand-900">Learning topics</h4>
        <ul class="flex flex-col gap-5.5">
          {data.topics.map((topic) => (
            <li class="flex flex-col gap-1.5">
              <p class="text-body font-semibold text-brand-900">{topic.title}</p>
              <p class="text-body/[1.6] text-copy">{topic.description}</p>
            </li>
          ))}
        </ul>
        {hasBody && (
          <div class="prose max-w-none prose-headings:font-semibold prose-headings:text-brand-900 prose-p:text-copy prose-li:text-copy prose-a:text-brand-900">
            <Content />
          </div>
        )}
      </div>
    )
  }

  {
    (data.applications.intro || data.applications.items.length > 0) && (
    <div class="flex flex-col gap-4.5 rounded-lg bg-brand-75 p-7 lg:w-85 lg:shrink-0">
      <h4 class="text-lg font-semibold text-brand-900">In your business</h4>
      {data.applications.intro && <p class="text-body/[1.65] text-copy">{data.applications.intro}</p>}
      {
        data.applications.items.length > 0 && (
          <ul class="flex flex-col gap-2.5">
            {data.applications.items.map((item) => (
              <li class="flex gap-2.5 text-small/[1.6] text-copy">
                <span aria-hidden="true" class="mt-2.25 size-1 shrink-0 bg-brand-900" />
                {item}
              </li>
            ))}
          </ul>
        )
      }
    </div>
    )
  }
</article>
