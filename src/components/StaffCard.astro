---
import { Image } from 'astro:assets';
import User from '@lucide/astro/icons/user';
import type { Person } from '../lib/staff';

interface Props {
  person: Person;
}

const { person } = Astro.props;
const { name, role, photoPosition } = person.data;
const positions = { top: 'object-top', center: 'object-center', bottom: 'object-bottom' };
---

<li class="flex w-full flex-col overflow-hidden rounded-lg border border-brand-100 bg-white sm:w-[calc((100%-1.25rem)/2)] lg:w-[calc((100%-3.75rem)/4)]">
  <div class="flex aspect-[4/5] items-center justify-center bg-brand-75">
    {
      person.photo ? (
        <Image src={person.photo} alt="" width={440} height={550} class:list={['size-full object-cover', positions[photoPosition]]} />
      ) : (
        <span class="flex size-16 items-center justify-center rounded-full bg-brand-100 text-muted" aria-hidden="true">
          <User size={28} />
        </span>
      )
    }
  </div>
  <div class="flex flex-1 flex-col gap-3 p-4.5">
    <div class="flex flex-col gap-1.5">
      <h3 class="text-title/[1.3] font-semibold text-brand-900 uppercase">{name}</h3>
      {role && <p class="text-small text-copy uppercase">{role}</p>}
    </div>
    {
      person.department && (
        <div class="mt-auto flex flex-col gap-1 border-t border-brand-100 pt-3">
          <p class="text-caption text-muted uppercase">Department</p>
          <p class="text-small font-semibold text-brand-900 uppercase">{person.department.data.title}</p>
        </div>
      )
    }
  </div>
</li>
