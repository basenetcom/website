---
import type { ImageMetadata } from 'astro';
import FooterCompany from './FooterCompany.astro';
import FooterNav from './FooterNav.astro';
import FooterContact from './FooterContact.astro';
import FooterLegal from './FooterLegal.astro';

interface Props {
  emblem?: ImageMetadata;
}

const { emblem } = Astro.props;
const hasCta = Astro.slots.has('cta');
---

<div class="relative bg-brand-900">
  <div class:list={['mx-auto flex max-w-6xl flex-col gap-10 px-8 pb-6 md:pb-8', hasCta ? 'pt-12 lg:pt-15' : 'pt-8']}>
    {hasCta && <slot name="cta" />}

    <footer class:list={['flex flex-col gap-7 md:gap-8', hasCta && 'border-t border-brand-800 pt-8']}>
      <div class="grid gap-7 md:grid-cols-2 md:gap-x-12 lg:grid-cols-[3fr_2fr_2fr] lg:gap-x-16">
        <FooterCompany {emblem} />
        <FooterNav />
        <FooterContact />
      </div>
      <FooterLegal />
    </footer>
  </div>
</div>
