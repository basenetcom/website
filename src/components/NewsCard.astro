---
import { Image } from 'astro:assets';
import ImageIcon from '@lucide/astro/icons/image';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import { formatDate, isoDate } from '../lib/content';
import { withBase } from '../nav';
import type { Article } from '../lib/news';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { title, summary, date } = article.data;
---

<li class="relative flex flex-col overflow-hidden rounded-lg border border-brand-100 bg-white transition-shadow focus-within:shadow-md hover:shadow-md motion-reduce:transition-none">
  <div class="flex h-40 items-center justify-center bg-brand-75 text-muted">
    {
      article.image ? (
        <Image src={article.image} alt="" width={640} height={320} class="size-full object-cover" />
      ) : (
        <ImageIcon size={28} aria-hidden="true" />
      )
    }
  </div>
  <div class="flex flex-1 flex-col gap-3 p-6">
    <div class="flex items-baseline justify-between gap-3 text-caption">
      <span class="font-semibold text-brand-900">{article.category?.data.title}</span>
      {date && <time datetime={isoDate(date)} class="text-muted">{formatDate(date)}</time>}
    </div>
    <h3 class="text-title/[1.3] font-semibold text-brand-900">
      <a
        href={withBase(`/news/${article.id}`)}
        class="rounded-sm after:absolute after:inset-0 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-brand-900"
      >
        {title}
      </a>
    </h3>
    {summary && <p class="line-clamp-3 text-small/[1.6] text-copy">{summary}</p>}
    <p aria-hidden="true" class="mt-auto flex items-center justify-between border-t border-brand-100 pt-3 text-caption font-semibold text-brand-900">
      Read more
      <ArrowUpRight size={14} />
    </p>
  </div>
</li>
