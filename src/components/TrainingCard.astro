---
import type { ImageMetadata } from 'astro';
import ProgramIcon from './ProgramIcon.astro';

interface Props {
  image: ImageMetadata | null;
  title: string;
  description: string;
  focus: string[];
  /** "lg" is the larger variant used on the Training page. */
  size?: 'md' | 'lg';
}

const { image, title, description, focus, size = 'md' } = Astro.props;
const lg = size === 'lg';
---

<div class="flex h-full flex-col gap-5 rounded-lg border border-brand-100 bg-white p-7.5">
  <ProgramIcon {image} />

  <div class="flex flex-col gap-3">
    <h3 class:list={['font-semibold text-brand-900', lg ? 'text-2xl tracking-tight' : 'text-title']}>{title}</h3>
    <p class:list={['text-copy', lg ? 'text-body/[1.65]' : 'text-small']}>{description}</p>
  </div>

  {
    focus.length > 0 && (
      <p class:list={['mt-auto border-t border-brand-100 pt-4 text-muted', lg ? 'text-small/[1.5]' : 'text-caption']}>
        {focus.join(' · ')}
      </p>
    )
  }
</div>
