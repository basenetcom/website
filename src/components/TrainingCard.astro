---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  title: string;
  description: string;
  focus: string[];
}

const { image, title, description, focus } = Astro.props;
---

<div class="flex flex-col gap-5 rounded-lg border border-brand-100 bg-white p-7.5">
  <div class="flex size-12 items-center justify-center overflow-hidden rounded-sm bg-brand-75">
    <Image src={image} alt="" width={84} height={84} class="size-10 object-contain" />
  </div>

  <div class="flex flex-col gap-3">
    <h3 class="text-title font-semibold text-brand-900">{title}</h3>
    <p class="text-small text-copy">{description}</p>
  </div>

  <p class="mt-auto border-t border-brand-100 pt-4 text-caption text-muted">{focus.join(' · ')}</p>
</div>
