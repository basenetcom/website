---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import ImageIcon from '@lucide/astro/icons/image';
import Layout from '../../layouts/Layout.astro';
import ContactCta from '../../components/ContactCta.astro';
import { getArticles, getCategories, type Article } from '../../lib/news';
import { formatDate, isoDate } from '../../lib/content';
import { withBase } from '../../nav';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { articleId: article.id } }));
}

const { articleId } = Astro.props;
const categories = await getCategories();
const articles = await getArticles(categories);
const article = articles.find((a) => a.id === articleId)!;
const { title, summary, date } = article.data;
const { Content } = await render(article);
const hasBody = Boolean(article.body?.trim());

// Up to two other articles: same category first, then the newest.
const others = articles.filter((a) => a.id !== article.id);
const related: Article[] = [
  ...others.filter((a) => article.category && a.category?.id === article.category.id),
  ...others.filter((a) => !(article.category && a.category?.id === article.category.id)),
].slice(0, 2);

const newsHref = withBase('/news');
const backLink =
  'inline-flex items-center gap-2.5 rounded-sm text-small font-semibold text-brand-900 hover:underline focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-brand-900';
---

<Layout title={title} description={summary || undefined}>
  <article aria-labelledby="article-title">
    <header class="bg-brand-75">
      <div class="mx-auto flex max-w-6xl flex-col gap-7 px-8 pt-8 pb-11">
        <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
          <nav aria-label="Breadcrumb">
            <ol class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-caption text-copy">
              <li><a href={withBase('/')} class="rounded-sm hover:underline focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-brand-900">Home</a></li>
              <li aria-hidden="true" class="text-muted">/</li>
              <li><a href={newsHref} class="rounded-sm hover:underline focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-brand-900">News</a></li>
              <li aria-hidden="true" class="text-muted">/</li>
              <li aria-current="page" class="font-semibold text-brand-900">{title}</li>
            </ol>
          </nav>
          <a href={newsHref} class={backLink}>
            <ArrowLeft size={18} aria-hidden="true" />
            Back to news
          </a>
        </div>

        <div class="flex max-w-5xl flex-col gap-5">
          <div class="flex items-baseline gap-5 text-caption">
            {article.category && <span class="font-semibold text-brand-900">{article.category.data.title}</span>}
            {date && <time datetime={isoDate(date)} class="text-copy">{formatDate(date)}</time>}
          </div>
          <h1 id="article-title" class="text-4xl/[1.1] font-bold tracking-tight text-brand-900 sm:text-5xl/[1.1] lg:text-[3.5rem]/[1.1]">{title}</h1>
          {summary && <p class="text-xl/[1.6] text-copy">{summary}</p>}
        </div>
      </div>
    </header>

    <div class="mx-auto flex max-w-6xl flex-col items-center gap-12 px-8 pt-10 pb-16">
      {
        article.image && (
          <Image
            src={article.image}
            alt=""
            width={1344}
            loading="eager"
            class="max-h-[435px] w-full rounded-lg object-contain"
          />
        )
      }

      <div class="flex w-full max-w-210 flex-col gap-8">
        {
          hasBody && (
            <div class="prose prose-lg max-w-none prose-headings:font-semibold prose-headings:text-brand-900 prose-p:text-copy prose-li:text-copy prose-a:text-brand-900 prose-strong:text-brand-900 prose-img:rounded-lg">
              <Content />
            </div>
          )
        }
        <div class="border-t border-brand-100 pt-6">
          <a href={newsHref} class={backLink}>
            <ArrowLeft size={18} aria-hidden="true" />
            Back to news
          </a>
        </div>
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section aria-labelledby="related-news-title" class="bg-brand-75">
        <div class="mx-auto flex max-w-6xl flex-col gap-6 px-8 py-12">
          <div class="flex items-center justify-between gap-4">
            <h2 id="related-news-title" class="text-2xl font-semibold text-brand-900 sm:text-heading">Related news</h2>
            <a href={newsHref} class={backLink}>
              View all news
              <ArrowUpRight size={14} aria-hidden="true" />
            </a>
          </div>
          <ul class="grid gap-6 md:grid-cols-2">
            {related.map((item) => (
              <li class="relative flex min-h-48 overflow-hidden rounded-lg border border-brand-100 bg-white transition-shadow focus-within:shadow-md hover:shadow-md motion-reduce:transition-none">
                <div class="flex w-32 shrink-0 items-center justify-center bg-brand-75 text-muted sm:w-48">
                  {item.image ? (
                    <Image src={item.image} alt="" width={400} height={480} class="size-full object-cover" />
                  ) : (
                    <ImageIcon size={24} aria-hidden="true" />
                  )}
                </div>
                <div class="flex min-w-0 flex-1 flex-col gap-3.5 p-6">
                  <div class="flex flex-col gap-1.5 text-caption">
                    {item.category && <span class="font-semibold text-brand-900">{item.category.data.title}</span>}
                    {item.data.date && <time datetime={isoDate(item.data.date)} class="text-muted">{formatDate(item.data.date)}</time>}
                  </div>
                  <h3 class="text-[1.375rem]/[1.3] font-semibold text-brand-900">
                    <a
                      href={withBase(`/news/${item.id}`)}
                      class="rounded-sm after:absolute after:inset-0 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-brand-900"
                    >
                      {item.data.title}
                    </a>
                  </h3>
                  <p aria-hidden="true" class="mt-auto flex items-center gap-2 text-small font-semibold text-brand-900">
                    Read more
                    <ArrowUpRight size={14} />
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <ContactCta slot="cta" />
</Layout>
