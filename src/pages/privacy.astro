---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { COMPANY } from '../site.config';
import { withBase } from '../nav';

const sections = [
  {
    title: 'Introduction',
    body: [
      `${COMPANY.legalName} ("we", "us", "our") is committed to protecting your personal data in accordance with the Personal Data Protection Act 2010 (PDPA) and its amendments. This policy explains what personal data we collect, why, and how we handle it.`,
    ],
  },
  {
    title: 'What data we collect',
    body: [
      'We may collect personal data such as your name, contact number, email address, and details you provide to us, through website contact and enquiry forms.',
    ],
  },
  {
    title: 'How we use your data',
    body: [
      'We use your personal data to respond to your enquiries, provide the services you request, communicate with you about our offerings (where you have consented), and comply with legal obligations.',
    ],
  },
  {
    title: 'Third-party processors',
    body: [
      'We may share your data with our service providers solely for the purposes described in this policy. We require these parties to protect your data in a manner consistent with this policy and applicable law.',
    ],
  },
  {
    title: 'Data retention',
    body: [
      'We retain your personal data for 3 years from last contact, unless a longer period is required by law, after which it is securely deleted or anonymised.',
    ],
  },
  {
    title: 'Data breach notification',
    body: [
      'In the event of a data breach that is likely to result in significant harm, we will notify the Personal Data Protection Commissioner and, where required, affected individuals, in accordance with our obligations under the PDPA and its amendments.',
    ],
  },
  {
    title: 'Your rights',
    body: [
      'You have the right to access, correct, and (where applicable) request deletion of your personal data, and to withdraw consent for marketing communications at any time.',
    ],
  },
];
---

<Layout
  title="Privacy Policy"
  description={`How ${COMPANY.legalName} collects, uses and protects your personal data under the Personal Data Protection Act 2010 (Malaysia).`}
>
  <PageHero
    crumbs={[{ label: 'Home', href: withBase('/') }, { label: 'Privacy Policy' }]}
    eyebrow="Legal"
    title="Privacy Policy"
    intro="Personal Data Protection Act 2010 (PDPA), Malaysia"
  />
  <div class="mx-auto max-w-3xl px-8 pt-12 pb-16">
    <p class="text-small text-copy">Last updated: 5 November 2026</p>
    <ol class="mt-8 flex flex-col gap-8">
      {
        sections.map((s, i) => (
          <li>
            <h2 class="text-xl font-bold text-brand-900">
              {i + 1}. {s.title}
            </h2>
            {s.body.map((p) => (
              <p class="mt-3 text-base/[1.7] text-copy">{p}</p>
            ))}
          </li>
        ))
      }
      <li>
        <h2 class="text-xl font-bold text-brand-900">{sections.length + 1}. Contact us</h2>
        <p class="mt-3 text-base/[1.7] text-copy">
          For any questions about this policy or your personal data, please contact us at
          <a href={`mailto:${COMPANY.supportEmail}`} class="font-semibold text-brand-900 underline hover:no-underline">{COMPANY.supportEmail}</a>.
        </p>
      </li>
    </ol>
  </div>
</Layout>
