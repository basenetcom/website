---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { COMPANY } from '../../site.config';
import { withBase } from '../../nav';

const purposes = [
  'to enable it to discharge its duties and obligations related to its functions or activities under the legislation administered by the Company and only when it is necessary for or directly related to such purposes;',
  'to enable it to discharge its contractual obligations;',
  'to enable the resolution of a concern or complaint;',
  'to create directories or databases whether for publication or not;',
  'to provide ongoing information about events and programs, training, our products and services to people that we believe are interested in such events, programs, training, products and services;',
  'to provide services;',
  'to research, develop and improve our events, programs, products and services;',
  'to respond to all your queries and emails; and',
  'for any other purpose that is incidental or ancillary or in furtherance to the above purposes as consented by you in writing.',
];

const h2 = 'text-2xl font-bold text-brand-900';
const p = 'text-base/[1.7] text-copy';
const link = 'font-semibold text-brand-900 underline hover:no-underline';
---

<Layout
  title="Our Governance"
  description={`${COMPANY.legalName} governance: Privacy Notice, Zero Tolerance on Bribery and Corruption Notice and No Gift Notice.`}
>
  <PageHero
    crumbs={[{ label: 'Home', href: withBase('/') }, { label: 'Our Governance' }]}
    eyebrow="Governance"
    title="Our Governance"
    intro="Privacy Notice, No Bribery and Corruption Notice & No Gift Notice"
  />
  <div class="mx-auto flex max-w-3xl flex-col gap-12 px-8 pt-12 pb-16">
    <header class="flex flex-col gap-3">
      <p class="text-xl font-bold text-brand-900">Let's Do the Right Thing!</p>
      <p class={p}>
        {COMPANY.legalName} is committed to conducting our business to the highest standards of integrity and good governance.
      </p>
    </header>

    <section aria-labelledby="privacy-notice" class="flex flex-col gap-4">
      <h2 id="privacy-notice" class={h2}>Privacy Notice</h2>
      <ol class="flex list-decimal flex-col gap-4 pl-6 marker:font-semibold marker:text-brand-900">
        <li class={p}>
          In line with the Personal Data Protection Act 2010 (hereinafter referred to as "PDPA"), which regulates the processing of personal data in commercial transactions, {COMPANY.legalName} ("the Company", "our", "us", or "we") seeks your consent to use, process and/or retain your personal data. For the purpose of this notice, the terms "personal data" and "processing" shall have the meaning prescribed in the PDPA.
        </li>
        <li class={p}>
          To facilitate your understanding of our use, disclosure and retention of your personal data, kindly refer to our <a href={withBase('/privacy')} class={link}>Privacy Policy</a>.
        </li>
        <li class={p}>
          The Company processes personal data which includes but is not limited to personal particulars including name, race, religion, date of birth, age, gender, marital status, address, contact details, national registration identity card (NRIC) number, passport number, educational and professional background, and information of any past breaches of or convictions under any law and all other details provided by you.
        </li>
        <li class={p}>
          The Company processes personal data for, among others, the following purposes:
          <ul class="mt-3 flex list-disc flex-col gap-2 pl-6">
            {purposes.map((t) => <li>{t}</li>)}
          </ul>
        </li>
        <li class={p}>
          You agree to provide the necessary personal data as required by the Company from time to time. The provision of such data is essential for the Company to fulfil the purposes outlined in Paragraph 4. Failure to provide the requested personal data may result in the Company being unable to proceed with certain processes or to continue any dealings with you. For any enquiries, please contact us at:
          <address class="mt-3 rounded-lg bg-brand-75 p-4 text-base/[1.7] not-italic text-copy">
            <strong class="text-brand-900">{COMPANY.legalName}, Compliance Team</strong><br />
            {COMPANY.address}<br />
            Email: <a href={`mailto:${COMPANY.supportEmail}`} class={link}>{COMPANY.supportEmail}</a><br />
            Phone: <a href={COMPANY.phone.href} class={link}>{COMPANY.phone.display}</a>
          </address>
        </li>
        <li class={p}>
          Your personal data is and will be collected from various sources, including information you have provided to the Company, information from third parties and information in the public domain.
        </li>
        <li class={p}>
          The Company shall keep all personal data confidential and endeavours to implement the appropriate administrative and security safeguards and procedures in accordance with the applicable laws and regulations to prevent the unauthorised or unlawful processing of personal data and accidental loss or destruction of, or damage to, personal data. Your personal data will not be transferred outside of the country without your prior written consent, unless such transfer is required by applicable laws or regulatory obligations.
        </li>
        <li class={p}>
          Where the Company considers it necessary to facilitate its processes and functions under Paragraph 4, the Company may transfer or share relevant personal data within or outside the Company, under conditions of confidentiality and similar level of security safeguards. Such a transfer of personal data will only be permitted to be carried out provided that the same is permitted by law and when the Company is satisfied that there are sufficient security standards to protect the integrity and confidentiality of such personal data.
        </li>
        <li class={p}>
          The Company retains personal data for as long as necessary to fulfil the purposes mentioned in Paragraph 4. Once these purposes are no longer applicable, the Company will either return the personal data to the data subject, securely destroy or permanently delete it, in accordance with the PDPA.
        </li>
        <li class={p}>
          The Company shall ensure that the personal data processed is accurate and up-to-date. The Company shall be kept informed of any changes to be made to personal data or if the personal data is not accurate.
        </li>
        <li class={p}>
          Under the PDPA, you have the right to access your personal data to ensure that the personal data we hold about you is accurate, complete, not misleading and up-to-date. If you wish to exercise such rights and request access to your personal data, please contact us through the contact information in Paragraph 5.
        </li>
        <li class={p}>
          By providing your personal data, you confirm that you have read, understood, and acknowledged the Company's Privacy Policy. You may withdraw your consent at any time by notifying us using the contact details provided in Paragraph 5.
        </li>
        <li class={p}>
          If you suspect that the Company is misusing your personal data, contact us through the contact information in Paragraph 5. If you suspect that your personal data has been stolen or compromised, report to the Personal Data Protection Commissioner. If you are a victim of a data breach, report at your nearest police station, change your password on all online accounts and contact your bank, if needed.
        </li>
      </ol>
    </section>

    <section aria-labelledby="anti-bribery" class="flex flex-col gap-4">
      <h2 id="anti-bribery" class={h2}>Zero Tolerance on Bribery and Corruption Notice</h2>
      <p class={p}>
        {COMPANY.legalName} establishes a culture of and adopts a policy of zero tolerance against all forms of bribery and corruption. We are committed to conducting our business dealings ethically with integrity, ensuring uncompromising adherence to professionalism, strong moral principles and laws and regulations enacted countering bribery and corruption.
      </p>
    </section>

    <section aria-labelledby="no-gift" class="flex flex-col gap-4">
      <h2 id="no-gift" class={h2}>No Gift Notice</h2>
      <p class={p}>
        We practise a "No Gift Policy" in all our dealings. Save as allowed under this Policy, all our employees (including their family members) and stakeholders shall not at any time accept from and/or offer gifts to third parties whether directly or indirectly, and must immediately refuse and/or return such gifts.
      </p>
      <p class={p}>
        This policy is for the avoidance of conflicts or the appearance of conflicts of interest in any of our ongoing or potential dealings.
      </p>
      <p class={p}>{COMPANY.legalName} thanks you for your continuous support.</p>
    </section>
    <section aria-labelledby="rbc" class="flex flex-col gap-4">
      <h2 id="rbc" class={h2}>Agreement on Responsible Business Conduct</h2>
      <p class={p}>
        By registering with {COMPANY.legalName}, you agree to comply with our Agreement on Responsible Business Conduct.
        <a href={withBase('/our-governance/agreement-on-responsible-business-conduct')} class={link}>Please click here to view the full document</a>.
      </p>
    </section>
  </div>
</Layout>
