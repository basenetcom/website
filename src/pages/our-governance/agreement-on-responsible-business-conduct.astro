      'No safety harness / safety shoe / safety helmet',
      'No Working at Height (WAH) Certification, Expired WAH',
      'No test pen, No electrical safety glove',
      'Fake CIDB / Fake WAH',
      'Life threatening / hazardous behavior or issue',
      'Pollution',
      'Forced Labour',
    ],
  },
  {
    no: '2',
    risk: 'Minor',
    action: 'Affected worker will be evicted from site, provide corrective actions within 7 days',
    items: [
      'No CIDB certification / Expired CIDB',
      'Illegal worker / No VISA / Expired work permit',
      'No First-Aid kit / Fire extinguisher',
      'Unsafe working behavior',
      'Safety Vest for team working by the side of the road',
      'Regulatory requirements',
    ],
  },
  {
    no: '3',
    risk: 'Minor',
    action: "Will notify the Company's Top Management",
    items: ['Living Conditions'],
  },
];

const ncAreas = [
  'Forced Labour - Not given at least one day off per week, original ID document kept by employer, not following local labour law on minimum wages, public holidays, annual leave, etc.',
  'Living Condition - Not provided with adequate and decent housing accommodation',
  'Team working by the side of the road will be required to wear safety vest',
];

const consequencesHead = ['Scenario', 'Tier 1', 'Tier 2', 'Tier 3 Onwards'];
const consequences = [
  {
    group: 'Child Labour, Fatality due to Negligence',
    rows: [
      { scenario: 'Child labour and Fatality on Tier 1', cells: [['Company will be suspended or terminated subject to circumstances'], [], []] },
      {
        scenario: 'Child labour and Fatality on Tier 2',
        cells: [['Company will be suspended or terminated subject to circumstances'], ['Company will be terminated from Group'], []],
      },
      {
        scenario: 'Child labour and Fatality on Tier 3',
        cells: [
          ['Company will be suspended or terminated subject to circumstances'],
          ['Company will be suspended or terminated subject to circumstances'],
          ['Company will be terminated from Group'],
        ],
      },
    ],
  },
  {
    group: 'Major Non-Conformance (NC)',
    rows: [
      {
        scenario: 'Major NC on Tier 1',
        cells: [
          [
            'Terminate team with major NC or company suspended for 6 months subject to circumstance',
            'WARNING Letter',
            '> 3 Warning Letters (within rolling 12 months from 1st warning letter) = company terminated from Group project; no reinstatement within 3 years',
          ],
          [],
          [],
        ],
      },
      {
        scenario: 'Major NC on Tier 2',
        cells: [
          [
            'WARNING Letter',
            '> 3 Warning Letters (within rolling 12 months from 1st warning letter) = company terminated from Group project; no reinstatement within 3 years',
          ],
          [
            'Company 1st warning letter & team terminated',
            '2nd warning letter (within rolling 12mths) = company terminated from Group project.',
            '(Subject to management)',
          ],
          [],
        ],
      },
      {
        scenario: 'Major NC on Tier 3 onward',
        cells: [
          [
            'WARNING Letter',
            '> 3 Warning Letters (within rolling 12 months from 1st warning letter) = company terminated from Group project (no reinstatement within 3 years)',
          ],
          [
            'Company 1st warning letter',
            '> 2nd Warning Letter (within rolling 12 months) = company suspended for 6 months from Group project',
            '> 3rd Warning Letter (within rolling 12mths) - company terminated from Group project (no reinstatement)',
            '(Subject to management)',
          ],
          [
            'Company 1st warning letter & team terminated',
            '2nd warning letter (within rolling 12mths) = company terminated from Group project (no reinstatement)',
            '(Subject to management)',
          ],
        ],
      },
    ],
  },
];

const h2 = 'text-2xl font-bold text-brand-900';
const h3 = 'text-lg font-bold text-brand-900';
const p = 'text-base/[1.7] text-copy';
const th = 'border border-brand-200 bg-brand-75 px-3 py-2 text-left text-small font-semibold text-brand-900';
const td = 'border border-brand-200 px-3 py-2 align-top text-small/[1.6] text-copy';
---

<Layout
  title="Agreement on Responsible Business Conduct"
  description={`The Agreement on Responsible Business Conduct that business partners of ${C} agree to comply with, including the Supplier Conduct Principles.`}
>
  <PageHero
    crumbs={[
      { label: 'Home', href: withBase('/') },
      { label: 'Our Governance', href: withBase('/our-governance') },
      { label: 'Agreement on Responsible Business Conduct' },
    ]}
    eyebrow="Governance"
    title="Agreement on Responsible Business Conduct"
    intro="The framework our vendors and suppliers agree to follow when working with us."
  />
  <div class="mx-auto flex max-w-4xl flex-col gap-12 px-8 pt-12 pb-16">
    <nav aria-label="On this page" class="rounded-lg bg-brand-75 p-4 text-small">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 font-semibold text-brand-900">
        <li><a class="underline hover:no-underline" href="#agreement">Agreement</a></li>
        <li><a class="underline hover:no-underline" href="#attachment-a">Attachment A: Supplier Conduct Principles</a></li>
        <li><a class="underline hover:no-underline" href="#attachment-b">Attachment B: Improvement Plan</a></li>
        <li><a class="underline hover:no-underline" href="#attachment-c">Attachment C: Non-Compliance Matrix</a></li>
      </ul>
    </nav>

    <section id="agreement" aria-labelledby="agreement-title" class="flex flex-col gap-6 scroll-mt-8">
      <h2 id="agreement-title" class={h2}>Agreement on Responsible Business Conduct</h2>
      <p class={p}>
        This agreement on responsible business conduct ("Agreement") is made and entered into at the date and place specified below by and between {C} including its subsidiaries, with its principal place of business at {COMPANY.address} (hereinafter referred to as "Purchaser", which term unless contradictory to the context and subject shall mean and include its nominees and successors-in-interest); their respective Vendor(s) and/or Supplier(s) (hereinafter referred to as "Business Partner", which term unless contradictory to the context and subject shall mean and include its nominees and successors-in-interest).
      </p>
      <p class={p}>
        The Purchaser and the Business Partner are hereinafter collectively referred to as "Parties" and individually as a "Party" as the context may require.
      </p>
      {
        sections.map((s) => (
          <div class="flex flex-col gap-3">
            <h3 class={h3}>{s.n}. {s.title}</h3>
            {s.clauses.map((c) => (
              <p class:list={[p, c.n && 'flex gap-3']}>
                {c.n && <span class="shrink-0 font-semibold text-brand-900">{c.n}</span>}
                <span>{c.text}</span>
              </p>
            ))}
          </div>
        ))
      }
    </section>

    <section id="attachment-a" aria-labelledby="attachment-a-title" class="flex flex-col gap-6 scroll-mt-8">
      <h2 id="attachment-a-title" class={h2}>Attachment A: Supplier Conduct Principles</h2>
      {
        principles.map((s) => (
          <div class="flex flex-col gap-3">
            <h3 class={h3}>{s.n}. {s.title}</h3>
            {s.clauses.map((c) => (
              <p class:list={[p, c.n && 'flex gap-3']}>
                {c.n && <span class="shrink-0 font-semibold text-brand-900">{c.n}</span>}
                <span>{c.text}</span>
              </p>
            ))}
          </div>
        ))
      }
    </section>

    <section id="attachment-b" aria-labelledby="attachment-b-title" class="flex flex-col gap-3 scroll-mt-8">
      <h2 id="attachment-b-title" class={h2}>Attachment B: Improvement Plan</h2>
      <p class={p}>(Upon request)</p>
    </section>

    <section id="attachment-c" aria-labelledby="attachment-c-title" class="flex flex-col gap-6 scroll-mt-8">
      <h2 id="attachment-c-title" class={h2}>Attachment C: Non-Compliance Matrix</h2>

      <h3 class={h3}>Types of Non-Compliance</h3>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse">
          <thead>
            <tr>
              <th scope="col" class={th}>No</th>
              <th scope="col" class={th}>Non-Compliance</th>
              <th scope="col" class={th}>Risk Classification</th>
              <th scope="col" class={th}>Immediate Action to Be Taken by the Parties</th>
            </tr>
          </thead>
          <tbody>
            {
              nonCompliance.map((r) => (
                <tr>
                  <td class={td}>{r.no}</td>
                  <td class={td}>
                    <ul class="flex list-disc flex-col gap-1 pl-4">
                      {r.items.map((i) => <li>{i}</li>)}
                    </ul>
                  </td>
                  <td class={td}>{r.risk}</td>
                  <td class={td}>{r.action}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="flex flex-col gap-2">
        <p class={p}>Non-compliance for the below areas if:</p>
        <ul class="flex list-disc flex-col gap-1 pl-6">
          {ncAreas.map((a) => <li class={p}>{a}</li>)}
        </ul>
      </div>

      <h3 class={h3}>Consequences of Non-Compliance for Child Labour, Fatality and Major Non-Compliances</h3>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[40rem] border-collapse">
          <thead>
            <tr>
              <th scope="col" class={th}><span class="sr-only">Category</span></th>
              {consequencesHead.map((h) => <th scope="col" class={th}>{h}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              consequences.map((g) =>
                g.rows.map((r, i) => (
                  <tr>
                    {i === 0 && (
                      <th scope="rowgroup" rowspan={g.rows.length} class={`${td} font-semibold text-brand-900`}>
                        {g.group}
                      </th>
                    )}
                    <th scope="row" class={`${td} font-normal`}>{r.scenario}</th>
                    {r.cells.map((c) => (
                      <td class:list={[td, c.length === 0 && 'bg-brand-75']}>
                        {c.length > 0 && (
                          <ul class="flex list-disc flex-col gap-1 pl-4">
                            {c.map((t) => <li>{t}</li>)}
                          </ul>
                        )}
                      </td>
                    ))}
                  </tr>
                ))
              )
            }
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Layout>
